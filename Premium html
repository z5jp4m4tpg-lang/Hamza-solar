  background:#080d15;
  border:1px solid var(--border);
  border-radius:12px;
  color:#fff;
  padding:14px;
  outline:none;
  font-size:15px;
}

input:focus,select:focus,textarea:focus{
  border-color:var(--gold);
}

.form-group{
  margin-bottom:18px;
}

.result{
  margin-top:20px;
  display:grid;
  gap:12px;
}

.result-item{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:16px;
  border-radius:13px;
  background:rgba(255,255,255,.04);
}

.result-item span{
  color:var(--muted);
}

.result-item strong{
  color:var(--gold);
}

.process{
  counter-reset:step;
}

.process-card{
  position:relative;
  padding-top:35px;
}

.process-card::before{
  counter-increment:step;
  content:counter(step);
  position:absolute;
  top:-16px;
  left:25px;
  width:40px;
  height:40px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--gold);
  color:#111;
  border-radius:50%;
  font-weight:900;
}

.service-area{
  background:
    radial-gradient(circle at 20% 50%,rgba(246,196,83,.12),transparent 35%),
    #0c1119;
}

.area-list{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:10px;
  margin-top:30px;
}

.area{
  padding:10px 16px;
  border-radius:30px;
  border:1px solid var(--border);
  background:rgba(255,255,255,.04);
  color:#dce2eb;
}

.cta{
  background:linear-gradient(135deg,#f6c453,#d99e20);
  color:#111;
  border-radius:28px;
  padding:50px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}

.cta h2{
  font-size:clamp(30px,5vw,48px);
  line-height:1.05;
}

.cta p{
  margin-top:12px;
  max-width:650px;
}

.cta .btn{
