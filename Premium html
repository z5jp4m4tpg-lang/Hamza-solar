  justify-content:space-between;
  gap:20px;
  padding:17px 0;
  border-bottom:1px solid var(--border);
}

.subsidy-row:last-child{
  border-bottom:0;
}

.subsidy-row span{
  color:var(--muted);
}

.subsidy-row strong{
  color:var(--gold);
}

.note{
  font-size:12px;
  color:#8e99aa;
  margin-top:18px;
}

.calculator-wrap{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
}

.calc-card{
  background:linear-gradient(145deg,#111824,#0c121c);
  border:1px solid var(--border);
  border-radius:22px;
  padding:30px;
}

label{
  display:block;
  color:#dce2eb;
  font-weight:700;
  margin-bottom:8px;
}

input,select,textarea{
