  height:52px;
  border-radius:15px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(246,196,83,.12);
  font-size:25px;
  margin-bottom:20px;
}

.card h3{
  font-size:21px;
  margin-bottom:10px;
}

.card p{
  color:var(--muted);
  font-size:14px;
}

.subsidy{
  background:
    linear-gradient(120deg,rgba(246,196,83,.14),rgba(255,255,255,.02)),
    var(--card);
}

.subsidy-grid{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:30px;
  align-items:stretch;
}

.subsidy-left h2{
  font-size:clamp(34px,5vw,55px);
  line-height:1.1;
  margin:12px 0 20px;
}

.subsidy-left h2 span{
  color:var(--gold);
}

.subsidy-left p{
  color:var(--muted);
  margin-bottom:24px;
}

.subsidy-points{
  display:grid;
  gap:12px;
}

.point{
  display:flex;
  gap:10px;
  color:#dce2eb;
}

.point b{
  color:var(--gold);
}

.subsidy-box{
