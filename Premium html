  color:#fff;
  border:0;
  white-space:nowrap;
}

.contact-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
}

.contact-card{
  background:linear-gradient(145deg,var(--card),var(--card2));
  border:1px solid var(--border);
  border-radius:22px;
  padding:30px;
}

.contact-person{
  display:flex;
  align-items:center;
  gap:15px;
  margin-bottom:22px;
}

.avatar{
  width:58px;
  height:58px;
  border-radius:50%;
  background:var(--gold);
  color:#111;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  font-weight:900;
}

.contact-person h3{
  margin:0;
}

.contact-person p{
  color:var(--muted);
  font-size:13px;
}

.contact-number{
  font-size:28px;
  font-weight:900;
  color:var(--gold);
  margin-bottom:18px;
}

.form-title{
  font-size:28px;
  margin-bottom:20px;
}

textarea{
  min-height:110px;
  resize:vertical;
}

footer{
  padding:35px 0 90px;
  color:#8993a3;
  border-top:1px solid var(--border);
  font-size:13px;
}

.footer-inner{
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:center;
}

.footer-brand{
  font-size:18px;
  font-weight:900;
  color:#fff;
}

.footer-brand span{
  color:var(--gold);
}

.float-buttons{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:999;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.float-btn{
  width:54px;
  height:54px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:23px;
  box-shadow:0 10px 25px rgba(0,0,0,.35);
}

.call{
  background:#fff;
  color:#111;
}

.whatsapp{
  background:var(--green);
  color:#fff;
}

.mobile-bar{
  display:none;
}

@media(max-width:850px){

  .nav{
    min-height:62px;
  }

  .nav-links{
    display:none;
  }

  .nav-btn{
    padding:9px 13px;
    font-size:12px;
  }

  .hero{
    min-height:auto;
  }

  .hero-content{
    padding:75px 0 55px;
  }

  .hero h1{
    font-size:47px;
  }

  .hero p{
    font-size:16px;
  }

  .hero-stats{
    grid-template-columns:1fr;
  }

  .stat{
    border-right:0;
    border-bottom:1px solid var(--border);
  }

  .stat:last-child{
    border-bottom:0;
  }

  section{
    padding:65px 0;
  }

  .grid-3{
    grid-template-columns:1fr;
  }

  .subsidy-grid,
  .calculator-wrap,
  .contact-grid{
    grid-template-columns:1fr;
  }

  .cta{
    padding:32px 25px;
    flex-direction:column;
    align-items:flex-start;
  }

  .footer-inner{
    flex-direction:column;
    align-items:flex-start;
  }

  .float-buttons{
    display:none;
  }

  .mobile-bar{
    position:fixed;
    display:grid;
    grid-template-columns:1fr 1fr;
    bottom:0;
    left:0;
    right:0;
    z-index:1000;
    background:#080b12;
    border-top:1px solid var(--border);
    padding:9px;
    gap:8px;
  }

  .mobile-bar a{
    text-align:center;
    padding:12px;
    border-radius:10px;
    font-weight:900;
  }

  .mobile-call{
    background:#fff;
    color:#111;
  }

  .mobile-wa{
    background:var(--green);
    color:#fff;
  }
}

@media(max-width:430px){

  .hero h1{
    font-size:40px;
  }

  .badge{
    font-size:10px;
  }

  .card,
  .calc-card,
  .contact-card{
    padding:22px;
  }

  .subsidy-box{
    padding:22px;
  }

  .subsidy-row{
    font-size:14px;
  }
}
</style>
</head>

