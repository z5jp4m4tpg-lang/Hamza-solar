<script>

function calculateSolar(){

  const billInput = document.getElementById("bill");
  const tariffInput = document.getElementById("tariff");

  const bill = Number(billInput.value);
  const tariff = Number(tariffInput.value);

  const systemEl = document.getElementById("system");
  const generationEl = document.getElementById("generation");
  const savingEl = document.getElementById("saving");
  const subsidyEl = document.getElementById("subsidyResult");

  if(!bill || !tariff || bill <= 0 || tariff <= 0){

    systemEl.textContent = "—";
    generationEl.textContent = "—";
    savingEl.textContent = "—";
    subsidyEl.textContent = "—";

    return;
  }

  const monthlyUnits = bill / tariff;

  /*
    Approximate solar generation:
    1 kW ≈ 120 units/month
  */

  let kw = Math.ceil(monthlyUnits / 120);

  if(kw < 1){
    kw = 1;
  }

  const generation = kw * 120;

  const offsetUnits = Math.min(monthlyUnits,generation);

  const saving = Math.round(offsetUnits * tariff);

  let subsidy = 0;

  if(kw === 1){
    subsidy = 30000;
  }
  else if(kw === 2){
    subsidy = 60000;
  }
  else{
    subsidy = 78000;
  }

  systemEl.textContent = kw + " kW";

  generationEl.textContent =
    "~" + generation.toLocaleString("en-IN") + " units/month";

  savingEl.textContent =
    "~₹" + saving.toLocaleString("en-IN") + "/month";

  subsidyEl.textContent =
    "Up to ₹" + subsidy.toLocaleString("en-IN");

}


